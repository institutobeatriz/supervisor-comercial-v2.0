# ============================================================
# SUPERVISOR COMERCIAL - Environment Variables
# ============================================================
# Copie para .env e configure suas chaves
# ============================================================

# ==========================================================
# MODO DE EXECUÇÃO
# ==========================================================
# "docker" = tudo em containers | "local" = api/worker local
MODE=local

# ==========================================================
# PORTA E AMBIENTE
# ==========================================================
PORT=3000
NODE_ENV=development
API_HOST=0.0.0.0

# ==========================================================
# ADMIN
# ==========================================================
ADMIN_API_KEY=change_me_to_secure_key

# ==========================================================
# DATABASE (PostgreSQL)
# ==========================================================
# Modo A (containers): usar nome do serviço "postgres"
# Modo B (local): usar "localhost"

# MODO A (tudo em Docker):
# DATABASE_URL=postgresql://app:app@postgres:5432/sales_supervisor
# REDIS_URL=redis://redis:6379

# MODO B (infra em Docker, api/worker local):
DATABASE_URL=postgresql://app:app@localhost:5432/sales_supervisor
REDIS_URL=redis://localhost:6379

# Pool
PG_POOL_MAX=10

# ==========================================================
# EVOLUTION API (WhatsApp)
# ==========================================================
# Variavel canonica usada em runtime
EVOLUTION_URL=http://localhost:8080
# Alias legado (compatibilidade temporaria)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_MEDIA_DOWNLOAD=false

# Webhook timeout (DEVE ser <= 150ms)
WEBHOOK_TIMEOUT=150

# ==========================================================
# STT — GROQ (APENAS Speech-to-Text)
# ==========================================================
# PROIBIDO usar Groq para chat/completions
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_API_KEY=your-groq-api-key
GROQ_STT_MODEL=whisper-large-v3-turbo

# ==========================================================
# CHAT LLM — NUNCA GROQ, NUNCA OLLAMA
# ==========================================================
# Provider Registry (OpenAI-compatible endpoints)

# Router config
PRIMARY_CHAT_PROVIDER=glm5
FALLBACK_CHAT_PROVIDERS=kimi,deepseek
PREMIUM_CHAT_PROVIDER=opus
PREMIUM_MODE=auto

# GLM-5 FP8 (Primário - Free)
GLM5_BASE_URL=https://api.modal.com/v1
GLM5_API_KEY=your-modal-api-key
GLM5_MODEL_CHEAP=zai-org/GLM-5-FP8
GLM5_MODEL_SMART=zai-org/GLM-5-FP8

# Kimi 2.5 (Fallback 1 - Free)
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_API_KEY=your-nvidia-api-key
KIMI_MODEL_CHEAP=moonshotai/kimi-k2.5
KIMI_MODEL_SMART=moonshotai/kimi-k2.5

# DeepSeek (Fallback 2 - Paid Light)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL_CHEAP=deepseek-chat
DEEPSEEK_MODEL_SMART=deepseek-chat

# Premium - Opus OU GPT (usar com moderação)
# Escolha um: opus ou gpt
# OPUS
OPUS_BASE_URL=https://api.anthropic.com/v1
OPUS_API_KEY=your-anthropic-api-key
OPUS_MODEL=claude-opus-4-6

# OU GPT
# GPT_BASE_URL=https://api.openai.com/v1
# GPT_API_KEY=your-openai-api-key
# GPT_MODEL=gpt-4o

# ==========================================================
# EMBEDDINGS (RAG) — PROVEDOR SEPARADO
# ==========================================================
# NUNCA usar Groq para embeddings
RAG_VECTOR=true

EMBEDDING_PROVIDER_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==========================================================
# WORKER (BullMQ)
# ==========================================================
WORKER_CONCURRENCY=5
JOB_TIMEOUT=60000
JOB_RETRIES=3
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002

# ==========================================================
# SCHEDULER (Cron)
# ==========================================================
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Horários dos relatórios
REPORT_DAILY_TIME=23:55
REPORT_WEEKLY_TIME=23:58

# ==========================================================
# PRIVACIDADE
# ==========================================================
ANONYMIZE_PHONE=false
ID_SALT_FOR_HASH=change_me_random_string

# ==========================================================
# LOGGING
# ==========================================================
LOG_LEVEL=info
LOG_FORMAT=json
# Diretório de auditoria (JSONL); default: <cwd>/logs
AUDIT_LOG_DIR=./logs

# ==========================================================
# MONITORAMENTO EXTERNO (Fase 10)
# ==========================================================
MONITOR_API_BASE=http://127.0.0.1:3000
# Opcional: usar quando worker health estiver exposto para fora do container
MONITOR_WORKER_BASE=
MONITOR_DOCKER_WORKER_CHECK=true
MONITOR_DOCKER_WORKER_CONTAINER=supervisor-worker
MONITOR_DOCKER_WORKER_REQUIRED=false

MONITOR_TIMEOUT_MS=8000
MONITOR_HISTORY_SIZE=288
MONITOR_MIN_SAMPLES_FOR_SLO=12
MONITOR_SLO_API_AVAILABILITY=99.5
MONITOR_SLO_WORKER_AVAILABILITY=99.0
MONITOR_MAX_LATENCY_HEALTH_MS=1500
MONITOR_MAX_LATENCY_API_MS=3500

# Webhook opcional para alerta de incidente/SLO breach
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_BEARER_TOKEN=
MONITOR_ALERT_SLACK_WEBHOOK_URL=
MONITOR_ALERT_DISCORD_WEBHOOK_URL=
MONITOR_ALERT_TELEGRAM_BOT_TOKEN=
MONITOR_ALERT_TELEGRAM_CHAT_ID=
MONITOR_ALERT_TELEGRAM_THREAD_ID=
MONITOR_ALERT_COOLDOWN_MINUTES=30

# Em CI, manter true para falhar pipeline em incidente
MONITOR_EXIT_ON_INCIDENT=true
MONITOR_STATE_FILE=./logs/monitoring/slo-state.json
MONITOR_REPORT_FILE=./logs/monitoring/last-report.json
MONITOR_INCIDENTS_FILE=./logs/monitoring/incidents.json
MONITOR_EXPECTED_INTERVAL_MINUTES=5

# Relatorio de confiabilidade (Fase 12)
RELIABILITY_REPORT_FILE=./logs/monitoring/reliability-summary.json
RELIABILITY_WINDOW_DAYS=30
RELIABILITY_ENFORCE_TARGETS=false
RELIABILITY_TARGET_MTTR_MIN=120
RELIABILITY_TARGET_MTTD_SEC=300
RELIABILITY_MAX_OPEN_INCIDENTS=0

# Dashboard e postmortem (Fase 13)
RELIABILITY_DASHBOARD_FILE=./docs/reliability-dashboard.md
POSTMORTEM_OUTPUT_DIR=./docs/postmortems
POSTMORTEM_INCLUDE_OPEN=false
POSTMORTEM_OVERWRITE=false
POSTMORTEM_MAX_ITEMS=50

# Integracao paging/ITSM (Fase 14)
INCIDENT_AUTOMATION_STATE_FILE=./logs/monitoring/incident-automation-state.json
INCIDENT_AUTOMATION_REPORT_FILE=./logs/monitoring/incident-automation-report.json
INCIDENT_AUTOMATION_TIMEOUT_MS=8000
INCIDENT_AUTOMATION_DRY_RUN=false
INCIDENT_AUTOMATION_REQUIRE_ENDPOINTS=false
INCIDENT_AUTOMATION_FAIL_ON_ERROR=false
INCIDENT_AUTOMATION_MAX_EVENTS_PER_INCIDENT=50

ONCALL_PAGING_WEBHOOK_URL=
ONCALL_PAGING_BEARER_TOKEN=
ITSM_TICKET_WEBHOOK_URL=
ITSM_TICKET_BEARER_TOKEN=
ITSM_SERVICE_NAME=supervisor-comercial
ITSM_TEAM=comercial-ops
ITSM_DEFAULT_OWNER=

# SLA por severidade (tier P1/P2/P3)
SLA_P1_ACK_MIN=5
SLA_P1_RESOLVE_MIN=60
SLA_P2_ACK_MIN=15
SLA_P2_RESOLVE_MIN=240
SLA_P3_ACK_MIN=60
SLA_P3_RESOLVE_MIN=1440

# Dashboard on-call executivo (Fase 15)
ONCALL_WINDOW_DAYS=30
ONCALL_DASHBOARD_FILE=./docs/oncall-dashboard.md
ONCALL_EXECUTIVE_REPORT_FILE=./logs/monitoring/executive-sla-report.json
ONCALL_AUDIT_FILE=./logs/monitoring/executive-audit-trail.jsonl

# Governanca enterprise (Fase 16)
ONCALL_ROTATION_FILE=./config/oncall-rotation.json
ONCALL_ROTATION_TIMEZONE=America/Sao_Paulo
ONCALL_OWNER_DYNAMIC_ENABLED=true
ONCALL_OWNER_PRESERVE_MANUAL=true
ONCALL_OWNER_REQUIRE_ASSIGNMENT=false

ITSM_SNAPSHOT_FILE=./logs/monitoring/itsm-snapshot.json
ITSM_RECONCILIATION_ENABLED=true
ITSM_RECONCILIATION_ALLOW_MISSING_SNAPSHOT=true
ITSM_RECONCILIATION_FAIL_ON_DRIFT=false
ITSM_TICKET_RESOLVED_STATUSES=resolved,closed,done
ITSM_TICKET_OPEN_STATUSES=open,in_progress,triage,acknowledged
ONCALL_PAGING_RESOLVED_STATUSES=resolved,closed
ONCALL_PAGING_OPEN_STATUSES=open,triggered,acknowledged,firing

SLO_EXECUTIVE_ENFORCE_TARGETS=false
SLO_EXEC_MIN_SAMPLES_PER_TIER=1
SLO_EXEC_MAX_OPEN_INCIDENTS=0
SLO_EXEC_P1_ACK_BREACH_RATE_MAX_PCT=0
SLO_EXEC_P1_RESOLVE_BREACH_RATE_MAX_PCT=0
SLO_EXEC_P2_ACK_BREACH_RATE_MAX_PCT=10
SLO_EXEC_P2_RESOLVE_BREACH_RATE_MAX_PCT=10
SLO_EXEC_P3_ACK_BREACH_RATE_MAX_PCT=20
SLO_EXEC_P3_RESOLVE_BREACH_RATE_MAX_PCT=20

GOVERNANCE_REPORT_FILE=./logs/monitoring/executive-governance-report.json
GOVERNANCE_DASHBOARD_FILE=./docs/executive-governance.md

# Governanca full-cycle (Fase 17)
ONCALL_CALENDAR_FILE=./config/oncall-calendar.json
FULLCYCLE_ACTIONS_FILE=./logs/monitoring/fullcycle-actions.json
FULLCYCLE_REPORT_FILE=./logs/monitoring/fullcycle-governance-report.json
FULLCYCLE_DASHBOARD_FILE=./docs/fullcycle-governance.md
GOVERNANCE_HISTORY_FILE=./logs/monitoring/governance-history.json
FULLCYCLE_APPLY_LOCAL_BACKFILL=false
FULLCYCLE_ENFORCE_TARGETS=false
FULLCYCLE_REQUIRE_GOVERNANCE_PASS=true
FULLCYCLE_MAX_PENDING_ACTIONS=20
FULLCYCLE_MAX_ORPHAN_EXTERNALS=0
FULLCYCLE_MIN_OWNER_COVERAGE_PCT=95
FULLCYCLE_MAX_HISTORY_ENTRIES=180

# Execucao ativa full-cycle (Fase 18)
FULLCYCLE_EXECUTION_STATE_FILE=./logs/monitoring/fullcycle-execution-state.json
FULLCYCLE_EXECUTION_REPORT_FILE=./logs/monitoring/fullcycle-execution-report.json
