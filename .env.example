FULLCYCLE_EXEC_RETRY_BACKOFF_MS=400
FULLCYCLE_EXEC_MAX_EVENTS_PER_INCIDENT=80
FULLCYCLE_EXEC_MAX_RUN_HISTORY=180

# Loop de convergencia full-cycle (Fase 19)
FULLCYCLE_CONVERGENCE_REPORT_FILE=./logs/monitoring/fullcycle-convergence-report.json
