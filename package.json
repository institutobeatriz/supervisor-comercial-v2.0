    "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.cjs",
    "format": "prettier --write \"**/*.ts\"",
    "clean": "rimraf apps/*/dist packages/*/dist node_modules",
    "typecheck": "tsc --noEmit",
