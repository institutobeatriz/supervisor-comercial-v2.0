{
  "name": "supervisor-comercial",
  "version": "1.0.0",
  "description": "Supervisor Comercial WhatsApp - Monitoramento shadow com IA",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @supervisor/api",
    "dev:worker": "npm run dev -w @supervisor/worker",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "local:infra": "docker compose --profile infra-only up -d",
    "local:up": "concurrently \"npm run start:api\" \"npm run start:worker\"",
    "build:packages": "npm run build -w @supervisor/audit -w @supervisor/db -w @supervisor/embeddings -w @supervisor/evolution -w @supervisor/governance -w @supervisor/llm -w @supervisor/planner -w @supervisor/rag -w @supervisor/stt -w @supervisor/vision",
    "build:apps": "npm run build -w @supervisor/api -w @supervisor/worker -w dashboard",
    "build": "npm run build:packages && npm run build:apps",
    "start:api": "node apps/api/dist/index.js",
    "start:worker": "npm run start -w @supervisor/worker",
    "start": "npm run start -w @supervisor/api",
    "db:migrate": "npm run migrate -w @supervisor/db",
    "db:reset": "npm run reset -w @supervisor/db",
    "docker:full": "docker compose --profile all-in-docker up -d --build",
    "docker:infra": "docker compose --profile infra-only up -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
