# Worker Dockerfile - Simplified
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY packages/db/package*.json ./packages/db/
COPY packages/audit/package*.json ./packages/audit/
COPY packages/embeddings/package*.json ./packages/embeddings/
COPY packages/evolution/package*.json ./packages/evolution/
COPY packages/governance/package*.json ./packages/governance/
COPY packages/llm/package*.json ./packages/llm/
COPY packages/planner/package*.json ./packages/planner/
COPY packages/rag/package*.json ./packages/rag/
COPY packages/stt/package*.json ./packages/stt/
COPY packages/vision/package*.json ./packages/vision/
COPY apps/worker/package*.json ./apps/worker/

# Install dependencies
RUN npm install

# Copy source code
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY infra/migrations ./infra/migrations
COPY tsconfig.json ./

# Build packages in order
RUN npx tsc -p packages/db/tsconfig.json
RUN npx tsc -p packages/audit/tsconfig.json
RUN npx tsc -p packages/embeddings/tsconfig.json
RUN npx tsc -p packages/evolution/tsconfig.json
RUN npx tsc -p packages/governance/tsconfig.json
RUN npx tsc -p packages/llm/tsconfig.json
RUN npx tsc -p packages/planner/tsconfig.json
RUN npx tsc -p packages/rag/tsconfig.json
RUN npx tsc -p packages/stt/tsconfig.json
RUN npx tsc -p packages/vision/tsconfig.json
RUN npx tsc -p apps/worker/tsconfig.json

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3002/health || exit 1

EXPOSE 3002

CMD ["node", "apps/worker/dist/index.js"]
