{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noEmitOnError": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@supervisor/vision": ["packages/vision/src/index.ts"],
      "@supervisor/vision/*": ["packages/vision/src/*"]
    }
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/index.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/simple.ts", "**/test-*.ts"]
}
