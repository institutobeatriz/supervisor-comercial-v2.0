{
  "version": 1,
  "sourceRoot": ".",
  "targetRoot": ".export-repo",
  "exclude": [
    ".git/",
    ".export-repo/",
    ".claude/",
    "node_modules/",
    "logs/",
    "coverage/",
    "dist/",
    "tmp/",
    "temp/",
    "tmp-gh-artifacts/",
    ".env",
    ".env.local",
    ".env.*.local",
    "*.log",
    "*.tsbuildinfo",
    "*.d.ts",
    "*.d.ts.map",
    "*.js.map",
    "*.mjs.map",
    "*.cjs.map",
    "audit-dashboard.json",
    "audit-root.json",
    "instituto-vendas-messages.json",
    "multivix-all-messages.json",
    "multivix-complete.json",
    "multivix-messages.json"
  ],
  "validateCommands": [
    "npm ci --include=dev",
    "npm run lint",
    "npm run typecheck",
    "npm run build",
    "npm run test:phase31",
    "npm run test:phase32",
    "npm run test:phase33",
    "npm run test:phase34",
    "npm run test:phase35",
    "npm run test:phase43",
    "npm run test:phase44",
    "npm run test:phase46",
    "npm run test:phase47",
    "npm run test:phase48",
    "npm run test:phase49",
    "npm run test:phase50",
    "npm run test:phase51"
  ],
  "git": {
    "repo": "institutobeatriz/supervisor-comercial-v2.0",
    "defaultBranch": "master",
    "branchPrefix": "codex/"
  }
}
