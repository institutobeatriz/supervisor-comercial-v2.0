{
  "version": 1,
  "connectors": {
    "itsm:generic": {
      "provider": "generic",
      "channel": "ticket",
      "owner": "platform-itsm",
      "runbook": "https://runbooks.example.com/connectors/itsm-generic",
      "sandbox": {
        "enabled": true,
        "endpoint": "https://sandbox.example.com/itsm",
        "credentialRef": "ITSM_SANDBOX_TOKEN"
      },
      "production": {
        "enabled": true,
        "endpoint": "https://prod.example.com/itsm",
        "credentialRef": "ITSM_PROD_TOKEN"
      }
    },
    "oncall:generic": {
      "provider": "generic",
      "channel": "paging",
      "owner": "platform-oncall",
      "runbook": "https://runbooks.example.com/connectors/oncall-generic",
      "sandbox": {
        "enabled": true,
        "endpoint": "https://sandbox.example.com/oncall",
        "credentialRef": "ONCALL_SANDBOX_TOKEN"
      },
      "production": {
        "enabled": true,
        "endpoint": "https://prod.example.com/oncall",
        "credentialRef": "ONCALL_PROD_TOKEN"
      }
    }
  }
}
